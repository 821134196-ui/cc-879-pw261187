# Local reverse proxy configuration. Copy to .env or export directly.
# All values are optional; defaults are in src/config.js.

# PROXY_PORT=8080
# PROXY_HOST=127.0.0.1
# PROXY_UPSTREAMS=127.0.0.1:9000,127.0.0.1:9001

# PROXY_MAX_ATTEMPTS=3
# PROXY_CONNECT_TIMEOUT_MS=1000
# PROXY_FIRST_HOP_TIMEOUT_MS=3000
# PROXY_COMMIT_AFTER_MS=200
# PROXY_COMMIT_AFTER_BYTES=16384
# PROXY_MAX_REQUEST_BODY_BYTES=4194304

# PROXY_BUDGET_CAPACITY=12
# PROXY_BUDGET_REFILL=3
# PROXY_MAX_IN_FLIGHT=8

# LOG_LEVEL=info
